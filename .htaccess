RewriteEngine On

# Форсуємо HTTPS + www в одному правилі (без подвійного редіректу)
RewriteCond %{HTTPS} !on [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.carlux.com.ua/$1 [R=301,L]

# ОБОВ'ЯЗКОВО: index.html містить PHP-код (<?php ... ?>)
# для роботи адмінки. Без цього рядка сервер віддасть сирий PHP-код замість сайту.
AddType application/x-httpd-php .html
